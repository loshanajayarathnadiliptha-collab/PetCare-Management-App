<jasperReport name="ProfitReport" language="java" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="3f2f0ab0-a2cd-4588-9ae8-b4952713c51c">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="jalani"/>
	<query language="SQL"><![CDATA[SELECT 
    m.medicine_name,
    SUM(pi.quantity) AS total_quantity_sold,
    SUM(pi.quantity * m.buying_price) AS total_cost,
    SUM(pi.quantity * m.selling_price) AS total_revenue,
    SUM(pi.quantity * (m.selling_price - m.buying_price)) AS total_profit
FROM prescription_items pi
JOIN medicines m ON pi.medicine_id = m.medicine_id
JOIN prescriptions pr ON pi.prescription_id = pr.prescription_id
JOIN invoices i ON pr.appointment_id = i.appointment_id
GROUP BY m.medicine_id, m.medicine_name;]]></query>
